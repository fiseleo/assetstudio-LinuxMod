#!/usr/bin/env bash
# AppImage entry point: starts the GUI; `AssetStudio-x86_64.AppImage cli <args>` runs the command line version.
HERE="$(dirname "$(readlink -f "$0")")"
if [ "${1:-}" = "cli" ]; then
    shift
    exec "$HERE/usr/lib/assetstudio/AssetStudio.CLI" "$@"
fi
exec "$HERE/usr/lib/assetstudio/AssetStudio.Avalonia" "$@"
